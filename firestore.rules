rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Perfiles: cualquiera puede leer, solo el dueño puede escribir
    match /perfiles/{uid} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Juegos: cualquier usuario autenticado puede leer y escribir
    match /juegos/{salaId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
